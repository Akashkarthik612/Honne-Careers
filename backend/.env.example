# Copy to .env for local runs. Never commit .env. Production values live in the Render env group.
ENV=dev
# Supabase session pooler (IPv4), login role honne_backend (see migrations). Not the postgres role.
DATABASE_URL=postgresql://honne_backend.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5173
LLM_STRONG=gemini:gemini-3.8-flash
LLM_LIGHT=gemini:gemini-3.5-flash-lite
GEMINI_API_KEY=
# LangSmith tracing: metadata only (agent, model, tokens, latency, ids), never CV/JD text.
# Turning it on without a key stops the app at startup.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=honne-careers-dev
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # unset = LangSmith's US endpoint
# Local PDF builds need tectonic on PATH (or TECTONIC_BIN=<path>).
# Application Database (Day 2): rows are hidden and then deleted this many days after the CV was sent.
# The one place the number lives; changing it needs no migration. A daily clean-up deletes old rows.
APPLICATION_RETENTION_DAYS=20
# JANITOR_ENABLED=true   # the daily clean-up loop (off in tests, which run it directly)
# Chats with agents (Day 3) are deleted on the same clock, counted from when the chat started.
# Usage limits (CVs and chats per day, custom agents per user) live in config/limits.yaml.
# LIMITS_FILE=config/limits.yaml       # only tests point this elsewhere
# Custom agents + chat (Day 3). Defaults shown; text lengths are fixed by the DB, not here.
# CHAT_TURNS_MAX=25                    # 50 messages, then "start a new chat"
# CHAT_LONG_WARN_TURNS=20              # 40 messages: "this chat is getting long" banner
# CHAT_CONCURRENT_TURNS_MAX=4          # per process; over it -> 429 agents_busy
# AGENT_TOOL_ROUNDS_MAX=4              # model rounds per turn (+1 forced answer)
# AGENT_TOOL_CALLS_MAX=6               # data-tool calls per turn
# AGENT_LLM_TIMEOUT_S=30
# AGENT_LLM_MAX_RETRIES=1
