# Copy to .env.local for local runs (git-ignored). Vite exposes VITE_ variables to the browser,
# so only browser-safe values go here: never the service-role key or any other secret.

# Supabase project (Project Settings › API): the project URL and the anon (publishable) key.
# The app refuses to start without them. In production they are set on the Render static site.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the backend API on Render, no trailing slash. Set in render.yaml for production.
# Leave unset in local dev: requests go to /api, which Vite proxies to http://localhost:8000 (vite.config.js).
VITE_API_BASE_URL=
