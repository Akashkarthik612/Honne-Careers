# Copy to .env.local for local overrides. Vite only exposes variables prefixed VITE_ to the browser,
# so never put secrets here.

# Base URL of the backend API on Render, no trailing slash, e.g. https://honne-careers-api.onrender.com
# Leave unset in local dev: requests to /api are proxied to http://localhost:8000 (vite.config.js).
# Set it in Vercel › Project › Settings › Environment Variables once the backend is deployed.
VITE_API_BASE_URL=
